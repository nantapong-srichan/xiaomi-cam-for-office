<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="OfficeCamera.MainWindow"
        Title="Office Camera" Width="1100" Height="700">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Grid.Row="0">
      <TextBlock Text="Office Camera" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="Xiaomi C400 · 2 กล้อง" Opacity="0.65" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,20,0,12">
      <Border Grid.Column="0" Background="#17191D" CornerRadius="8" Margin="0,0,8,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="ห้องเรียน · 192.168.1.3" Margin="14,12" FontWeight="SemiBold" />
          <vlc:VideoView Grid.Row="1" Name="ClassroomVideoView" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="#17191D" CornerRadius="8" Margin="8,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="ห้องนั่ง · 192.168.1.4" Margin="14,12" FontWeight="SemiBold" />
          <vlc:VideoView Grid.Row="1" Name="LivingroomVideoView" />
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
      <Button Content="เปิดทั้งสองกล้อง" Click="ConnectBoth" />
      <Button Content="เปิดห้องเรียน" Click="ConnectClassroom" />
      <Button Content="เปิดห้องนั่ง" Click="ConnectLivingroom" />
      <TextBlock Name="Status" Text="พร้อมใช้งาน" VerticalAlignment="Center" Opacity="0.7" />
    </StackPanel>
  </Grid>
</Window>
